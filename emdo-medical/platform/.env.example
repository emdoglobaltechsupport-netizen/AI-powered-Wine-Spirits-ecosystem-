# Copy to .env and replace every value. Never commit real secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. Do not use a production database for tests.
DATABASE_URL=postgres://emdo_app:change-me@127.0.0.1:5432/emdo_dev
TEST_DATABASE_URL=postgres://emdo_app:change-me@127.0.0.1:5432/emdo_test

# Base64-encoded 32-byte master data encryption key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# JWT signing keys. Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=REPLACE_WITH_BASE64_48_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_BASE64_48_BYTES
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Country behaviour. No country is activated by default.
# In production only profiles with status=approved are accepted.
COUNTRY_PROFILE_MODE=sandbox
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Security
SCRYPT_COST=14
AUDIT_RETENTION_DAYS=2555
MAX_AUDIT_PAGE_SIZE=200

# M9 AI gateway. Offline is the only implemented backend (non-clinical prototype).
# Production fails closed until an approved, tested provider and residency decision exist.
AI_MODEL_BACKEND=offline

# M10 Super Admin portal (D-026). The API base must be the tested local Insight API.
INSIGHT_API_BASE_URL=http://127.0.0.1:3000
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The portal refuses to create sessions when this is missing or a placeholder.
ADMIN_SESSION_SECRET=REPLACE_WITH_BASE64_32_BYTES
