# Staging configuration template. Copy to .env.staging and fill from a secret store.
# This is configuration only: no staging environment is provisioned or deployed.
# Never commit .env.staging. Placeholders are rejected by startup validation.

NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# Staging database. Use a synthetic-only database, never production or patient data.
POSTGRES_DB=emdo_staging
POSTGRES_USER=emdo_app
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_POSTGRES_PASSWORD
DATABASE_URL=postgres://emdo_app:REPLACE_WITH_STAGING_POSTGRES_PASSWORD@db:5432/emdo_staging

# Generate each value locally; never reuse development or production keys.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  # data key
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"  # JWT secrets
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
JWT_ACCESS_SECRET=REPLACE_WITH_BASE64_48_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_BASE64_48_BYTES
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# No country is activated. Staging remains non-clinical.
COUNTRY_PROFILE_MODE=sandbox
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_STAGING_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_STAGING_PASSWORD

SCRYPT_COST=14
AUDIT_RETENTION_DAYS=2555
MAX_AUDIT_PAGE_SIZE=200
AI_MODEL_BACKEND=offline

# Super Admin portal. The API base uses the compose service name.
INSIGHT_API_BASE_URL=http://api:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=REPLACE_WITH_BASE64_32_BYTES
