{
  "name": "@emdo/api",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "migrate": "ts-node src/database/migrate.ts",
    "bootstrap": "ts-node src/bootstrap.ts",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@emdo/shared": "0.1.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "ts-node": "^10.9.2"
  }
}
