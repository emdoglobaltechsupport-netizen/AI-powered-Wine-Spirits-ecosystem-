{
  "name": "vintora",
  "version": "0.1.0",
  "private": true,
  "description": "Vintora — AI-native global wine & spirits ecosystem (Phase 1 foundation)",
  "license": "Apache-2.0",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "24.x || 26.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate --workspace @vintora/api",
    "db:setup": "npm run db:setup --workspace @vintora/api",
    "db:reset": "node scripts/refuse-destructive-db-reset.mjs",
    "db:ops:check": "node scripts/check-database-operations.mjs",
    "db:migrations:test": "npm run db:migrations:test --workspace @vintora/api",
    "db:seed:dev": "npm run db:seed:dev --workspace @vintora/api",
    "db:configure": "node scripts/configure-local-db.mjs",
    "db:health": "node scripts/service-health.mjs db",
    "api:health": "node scripts/service-health.mjs api",
    "with-env": "node scripts/with-env.mjs",
    "catalogue:ingest": "npm run catalogue:ingest --workspace @vintora/db",
    "catalogue:import": "npm run catalogue:import --workspace @vintora/db",
    "catalogue:selftest": "npm run catalogue:selftest --workspace @vintora/db",
    "accessories:ingest": "npm run accessories:ingest --workspace @vintora/db",
    "accessories:import": "npm run accessories:import --workspace @vintora/db",
    "accessories:selftest": "npm run accessories:selftest --workspace @vintora/db",
    "africa:build": "npm run africa:build --workspace @vintora/db",
    "africa:import": "npm run africa:import --workspace @vintora/db",
    "africa:selftest": "npm run africa:selftest --workspace @vintora/db",
    "dev:api": "npm run dev --workspace @vintora/api",
    "dev:web": "npm run dev --workspace @vintora/web",
    "dev:down": "docker compose down",
    "setup": "node scripts/setup.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:doctor": "node scripts/setup-doctor.mjs",
    "setup:verify": "node scripts/setup.mjs --verify-only",
    "serve:prototype": "node scripts/serve-prototype.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "artifacts:check": "node scripts/check-artifact-pins.mjs",
    "gates:check": "node scripts/validate-feature-gates.mjs",
    "identity:check": "node scripts/check-identity-access-policy.mjs",
    "admin:check": "node scripts/check-admin-access-policy.mjs",
    "adapters:check": "node scripts/check-adapter-capabilities.mjs",
    "agents:check": "node scripts/check-agent-autonomy-policy.mjs",
    "ai:safety:check": "node scripts/check-ai-safety.mjs",
    "privacy:check": "node scripts/check-privacy-consent-policy.mjs",
    "data-governance:check": "node scripts/check-data-governance.mjs",
    "marketing:check": "node scripts/check-marketing-release-policy.mjs",
    "external-actions:check": "node scripts/check-external-marketing-actions.mjs",
    "responsible-drinking:check": "node scripts/check-responsible-drinking.mjs",
    "pricing:check": "node scripts/check-pricing-controls.mjs",
    "security:check": "node scripts/check-security-architecture.mjs",
    "scale:check": "node scripts/check-scale-evidence.mjs",
    "docs:check": "node scripts/check-docs-governance.mjs",
    "policy:check": "node scripts/check-repository-policy.mjs",
    "forecasts:check": "node scripts/validate-forecasts.mjs",
    "financial:check": "node scripts/validate-financial-assumptions.mjs --check",
    "financial:docs": "node scripts/validate-financial-assumptions.mjs --write-docs",
    "jurisdiction:check": "node scripts/check-jurisdiction-compliance.mjs",
    "launch:check": "node scripts/check-launch-gate.mjs",
    "catalogue:provenance:check": "node scripts/check-catalogue-provenance.mjs",
    "credentials:check": "node scripts/check-demo-credentials.mjs",
    "boundaries:check": "node scripts/check-runtime-boundaries.mjs",
    "safeguards:check": "node scripts/check-commerce-safeguards.mjs",
    "claims:check": "node scripts/check-doc-claims.mjs",
    "test:shared": "npm run test --workspace @vintora/shared",
    "test:smoke": "npm run test:smoke --workspace @vintora/api",
    "test-counts:generate": "node scripts/generate-test-counts.mjs",
    "test-counts:docs": "node scripts/generate-test-counts.mjs --write-docs",
    "test-counts:check": "node scripts/generate-test-counts.mjs --check",
    "adr:check": "node scripts/check-adr-process.mjs",
    "canonical:check": "node scripts/check-canonical-metadata.mjs",
    "evidence:check": "node scripts/check-evidence-index.mjs",
    "fixtures:check": "node scripts/check-fixture-taxonomy.mjs",
    "claims-change:check": "node scripts/check-claims-change-management.mjs",
    "status:check": "node scripts/check-status-dashboard.mjs",
    "retention:check": "node scripts/check-data-retention-architecture.mjs",
    "network:check": "node scripts/check-network-isolation.mjs",
    "markdown:check": "node scripts/check-markdown-and-schemas.mjs --markdown",
    "schemas:check": "node scripts/check-markdown-and-schemas.mjs --schemas",
    "health:check": "npm run db:health && npm run api:health",
    "verify": "npm run typecheck --workspace @vintora/api && npm run test --workspace @vintora/shared",
    "prototype": "node scripts/serve-prototype.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "ci:verify": "npm run setup:doctor -- --offline && npm run db:ops:check && npm run test-counts:check && npm run verify && npm run catalogue:selftest && npm run accessories:selftest && npm run africa:selftest && npm run secrets:scan && npm run licenses:check && npm run artifacts:check && npm run policy:check && npm run identity:check && npm run admin:check && npm run adapters:check && npm run agents:check && npm run ai:safety:check && npm run privacy:check && npm run data-governance:check && npm run marketing:check && npm run external-actions:check && npm run responsible-drinking:check && npm run pricing:check && npm run safeguards:check && npm run catalogue:provenance:check && npm run credentials:check && npm run boundaries:check && npm run launch:check && npm run jurisdiction:check && npm run claims:check && npm run docs:check && npm run security:check && npm run scale:check && npm run gates:check && npm run forecasts:check && npm run financial:check && npm run adr:check && npm run canonical:check && npm run evidence:check && npm run fixtures:check && npm run claims-change:check && npm run status:check && npm run retention:check && npm run network:check && npm run markdown:check && npm run schemas:check",
    "ci:build": "npm run build --workspace @vintora/api && npm run build --workspace @vintora/shared && npm run sbom:check"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
