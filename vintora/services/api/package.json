{
  "name": "@vintora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'api: run test:smoke with the API running'",
    "test:smoke": "node scripts/smoke.mjs",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:setup": "tsx src/db/cli.ts",
    "db:migrations:test": "tsx scripts/migration-mode-check.ts",
    "db:seed:dev": "tsx src/db/seed-dev-cli.ts",
    "lint": "echo 'api: lint pending'"
  },
  "dependencies": {
    "@vintora/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
