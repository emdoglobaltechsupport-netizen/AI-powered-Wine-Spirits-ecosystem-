# Credential-free template. `npm run setup` generates .env with random local
# development values. Never commit .env or paste real credentials into this file.

NODE_ENV=development
# Runtime profile: local, test, staging or production. Production is rejected.
RUNTIME_PROFILE=local
PORT=4000
WEB_ORIGIN=http://localhost:8123

# Container database identity. POSTGRES_PASSWORD is generated by setup.
POSTGRES_USER=vintora
POSTGRES_DB=vintora
POSTGRES_PASSWORD=
# Host-side connection generated from POSTGRES_USER/PASSWORD/PORT/DB. Compose
# overrides the hostname to the `db` service for containers.
DATABASE_URL=

# Embedding storage mode for migrations: auto detects pgvector, pgvector fails
# closed without the extension, jsonb forces the portable fallback. The mode
# actually used is recorded in schema_migration_metadata and exposed by /health.
EMBEDDING_MODE=auto

# Local host port mapping. Change these only to avoid conflicts; containers
# keep their internal ports (5432, 6379, 4000 and 8123). DATABASE_URL is
# regenerated to match POSTGRES_USER, POSTGRES_DB and POSTGRES_PORT.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
PROTOTYPE_PORT=8123

# Session auth. Generated by setup; must be at least 32 characters.
SESSION_SECRET=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Optional prototype-only rate limits (non-secret; safe local defaults).
# Production requires a distributed limiter backed by shared state.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Seeded demo identities are local/test only and non-production. Passwords are
# first-run generated values; no fixed password exists. Keep ALLOW_DEMO_SEED=false
# in any shared or deployed template; local setup opts in for throwaway databases.
ALLOW_DEMO_SEED=false
SEED_ADMIN_EMAIL=admin@vintora.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=demo@vintora.local
SEED_USER_PASSWORD=

# Adapters. Simulated values are the default in local/test; staging requires
# ALLOW_SIMULATED_PROVIDERS=true. Real adapters require both global and provider
# opt-ins plus a profile-scoped key named REAL_{PROVIDER}_KEY_{PROFILE}; they are
# blocked by the prototype launch, licence and provider evidence gates.
AGE_VERIFICATION_PROVIDER=local
KYC_PROVIDER=local
PAYMENT_PROVIDER=simulated
MARKETING_PROVIDER=simulated
CUSTODY_PROVIDER=simulated
AI_PROVIDER=deterministic
REAL_PROVIDER_OPT_IN=false
ALLOW_SIMULATED_PROVIDERS=true
REAL_AGE_PROVIDER_OPT_IN=false
REAL_KYC_PROVIDER_OPT_IN=false
REAL_PAYMENT_PROVIDER_OPT_IN=false
REAL_MARKETING_PROVIDER_OPT_IN=false
REAL_CUSTODY_PROVIDER_OPT_IN=false
REAL_AI_PROVIDER_OPT_IN=false
CATALOGUE_SOURCE=demo
STRIPE_SECRET_KEY=
ADYEN_API_KEY=

REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# Verified catalogue ingestion. No source is contacted unless its flag is set.
VINTORA_LICENSED_FEED_PATH=
VINTORA_LICENSED_FEED_LICENSE=
VINTORA_CATALOGUE_MIN_CONFIDENCE=0.7
VINTORA_OFF_BASE_URL=https://world.openfoodfacts.org
VINTORA_OFF_USER_AGENT=VintoraCatalogueIngest/0.1 (contact: replace-with-your-contact)
VINTORA_OFF_PAGE_SIZE=100
VINTORA_OFF_PAGES=5
VINTORA_OFF_DELAY_MS=1000

# Wine Accessories catalogue domain. No assets are imported without licence,
# authorisation reference and approved image moderation metadata.
VINTORA_WINE_ACCESSORIES_FEED_PATH=
VINTORA_WINE_ACCESSORIES_MIN_CONFIDENCE=0.7

# Africa Marketplace registry. Candidate gateways are not integrations;
# credentials must never be committed and require local legal review before use.
VINTORA_AFRICA_MARKETPLACE_CONFIG=packages/db/config/africa-marketplace.json
VINTORA_AFRICA_BRANDS_CONFIG=packages/db/config/africa-brand-candidates.json
VINTORA_AFRICA_MPESA_CONSUMER_KEY=
VINTORA_AFRICA_MPESA_CONSUMER_SECRET=
VINTORA_AFRICA_CARD_GATEWAY_KEY=
VINTORA_AFRICA_BANK_TRANSFER_KEY=

# CI supplies database credentials as job environment variables, never here.
