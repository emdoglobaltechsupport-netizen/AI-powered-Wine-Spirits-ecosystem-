{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vintora.local/schemas/catalogue.import.schema.json",
  "title": "Vintora verified catalogue import row",
  "description": "One catalogue row produced by catalogue-ingest.mjs. Null/empty values mean the source did not supply that fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category", "subcategory", "brand_name", "product_name", "country_of_origin",
    "region", "producer_distillery", "abv_pct", "bottle_size", "bottle_size_ml",
    "tasting_notes", "food_pairing", "awards", "product_description",
    "msrp_price_usd", "average_global_retail_price_usd", "product_sku", "barcode",
    "official_brand_website", "official_product_page", "official_product_image_url",
    "additional_gallery_images", "product_tags", "premium_luxury_segment",
    "popularity_score", "ai_recommendation_tags", "provenance"
  ],
  "properties": {
    "category": { "type": "string" },
    "subcategory": { "type": "string" },
    "brand_name": { "type": ["string", "null"] },
    "product_name": { "type": ["string", "null"] },
    "country_of_origin": { "type": ["string", "null"] },
    "region": { "type": ["string", "null"] },
    "producer_distillery": { "type": ["string", "null"] },
    "abv_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "bottle_size": { "type": ["string", "null"] },
    "bottle_size_ml": { "type": ["integer", "null"], "minimum": 1 },
    "tasting_notes": { "type": ["string", "null"] },
    "food_pairing": { "type": ["string", "null"] },
    "awards": { "type": "array", "items": { "type": "string" } },
    "product_description": { "type": ["string", "null"] },
    "msrp_price_usd": { "type": ["number", "null"], "minimum": 0 },
    "average_global_retail_price_usd": { "type": ["number", "null"], "minimum": 0 },
    "product_sku": { "type": ["string", "null"] },
    "barcode": { "type": ["string", "null"], "pattern": "^$|^\\d{8,14}$" },
    "official_brand_website": { "type": ["string", "null"] },
    "official_product_page": { "type": ["string", "null"] },
    "official_product_image_url": { "type": ["string", "null"] },
    "additional_gallery_images": { "type": "array", "items": { "type": "string" } },
    "product_tags": { "type": "array", "items": { "type": "string" } },
    "premium_luxury_segment": { "type": ["string", "null"] },
    "popularity_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "ai_recommendation_tags": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "required": ["source", "source_record_id", "licence", "retrieved_at", "overall_confidence"],
      "properties": {
        "source": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "source_record_id": { "type": "string" },
        "source_url": { "type": ["string", "null"] },
        "licence": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] },
        "source_priority": { "type": "number" },
        "source_image_url": { "type": ["string", "null"] },
        "unclassified": { "type": "boolean" },
        "confidence": { "type": "object", "additionalProperties": { "enum": ["verified", "derived", "missing"] } },
        "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
