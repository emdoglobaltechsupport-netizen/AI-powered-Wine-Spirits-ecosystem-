    { "id": "AM-006", "severity": "error", "description": "Availability must be evaluated per target market; absence of evidence is unverified, not available." },
    { "id": "AM-007", "severity": "error", "description": "Regional tax calculations must reference a reviewed tax rule and currency." },
    { "id": "AM-008", "severity": "error", "description": "Distributor records require KYC, licence evidence and brand authorisation before activation." },
