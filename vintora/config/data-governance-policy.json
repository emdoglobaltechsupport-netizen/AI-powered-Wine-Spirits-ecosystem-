    { "id": "ai_interaction_log", "category": "AI audit", "identityDomain": "audit", "source": "prompt, model, retrieval and response metadata", "sensitivity": "personal", "purposes": [], "retentionDays": 90, "systemOfRecord": "AI provenance log" },
    { "id": "marketing_audience", "category": "derived audience", "identityDomain": "analytics", "source": "consented engagement and age-region token only", "sensitivity": "personal", "purposes": ["marketing"], "retentionDays": 180, "systemOfRecord": "audience draft store" },
    { "id": "health_adjacent", "category": "health", "identityDomain": "commerce", "source": "health or wellbeing assertions", "sensitivity": "restricted", "purposes": [], "retentionDays": 0, "systemOfRecord": "not collected" },
