  "lifecycleWorkflows": {
    "export": {
      "endpoint": "POST /v1/privacy/export",
      "confirmation": "EXPORT_MY_DATA",
      "steps": ["verify session identity", "queue simulated manifest", "human-reviewed fulfilment", "record decision"],
      "slaDays": 30,
      "implemented": "simulated-only"
    },
    "deletion": {
      "endpoint": "POST /v1/privacy/deletion-request",
      "confirmation": "DELETE_MY_DATA",
      "steps": ["verify session identity", "queue reviewed request", "check legal hold", "delete or crypto-shred", "emit erasure event"],
      "slaDays": 30,
      "implemented": "human-reviewed-request-only"
    },
    "optOut": {
      "endpoint": "POST /v1/privacy/consents",
      "decision": "withdraw",
      "steps": ["record versioned withdrawal", "propagate to purpose store", "deny on next evaluation"],
      "implemented": "prototype-decision-only"
    },
    "revocation": {
      "endpoint": "POST /v1/privacy/consents",
      "decision": "withdraw",
      "steps": ["record versioned withdrawal", "propagate to purpose and audience stores", "deny on next evaluation", "record propagation result"],
      "propagationTargets": ["recommendations", "marketing", "experimentation", "audience_drafts"],
      "propagationWindowHours": 24,
      "propagationCompleted": false,
      "implemented": "required-not-executed"
    }
  },
  "retentionSchedule": {
    "aiLogDays": 90,
    "transactionRecordDays": 2555,
    "kycLogDays": 2190,
    "custodyRecordDays": 3650,
    "marketingAudienceDays": 180,
    "enforced": false,
    "legalHoldModel": "required-not-implemented"
  },
  "crossBorderTransfer": {
    "enabled": false,
    "allowedRegions": [],
    "approvedMechanisms": [],
    "transferImpactAssessmentCompleted": false,
    "subprocessors": [],
    "evidenceRef": null,
    "rule": "No regulated or personal data may leave its storage region until a lawful mechanism, TIA and processor agreement are attached."
  },
  "audit": {
    "appendOnly": true,
    "requiredFields": ["correlationId", "tenantId", "actorUserId", "purpose", "dataCategory", "action", "decision", "reasonCode", "reason", "occurredAt"]
  },
  "evidenceGaps": [
    "No production consent receipt, processor agreement or signed record of processing exists.",
    "No retention or deletion job is implemented; schedules are design targets only.",
    "No cross-border mechanism, transfer impact assessment or subprocessor list is approved.",
    "No production DSAR fulfilment, legal-hold check or withdrawal propagation to downstream systems exists.",
    "No DPIA has been completed; all lawful bases are design targets without evidence references."
  ]
}
