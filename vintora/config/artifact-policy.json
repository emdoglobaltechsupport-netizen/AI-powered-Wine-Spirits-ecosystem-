    "redis:7-alpine": "sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe"
  },
  "evidence": [
    "sbom/vintora.cdx.json",
    "audit-full.json",
    "audit-scoped.json",
    "trivy-iac.sarif",
    "trivy-image.sarif",
