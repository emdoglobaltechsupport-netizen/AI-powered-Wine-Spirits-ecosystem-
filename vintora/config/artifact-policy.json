{
  "version": 1,
  "policy": {
    "owner": "Platform Security",
    "promotion": "digest-only",
    "requireImageDigests": true,
    "requirePinnedActions": true,
    "requireSignatures": true,
    "requireChecksums": true,
    "retainEvidenceDays": 365,
    "note": "Local development and release builds use the same digest-pinned base images. Build once, promote the resulting digest, and never rebuild per environment. GitHub Actions are pinned to commit SHAs with version comments so Dependabot can update them safely."
  },
