{
  "prototypeOnly": true,
  "localProfiles": ["local", "test"],
  "generatedSeedPasswordPrefix": "LocalDev-",
  "generatedSecretMinimumLength": 32,
  "sessionSecretMinimumLength": 32,
  "legacyPasswordPatterns": [
    "^Vintora(?:Admin|Demo)![A-Za-z0-9]{4,}$",
    "^vintora$",
    "^changeme",
    "^local-dev-session-secret-"
  ],
  "legacySessionSecretPatterns": [
    "^local-dev-session-secret-",
    "^changeme",
    "^example",
    "^your-",
    "^placeholder"
  ],
  "demoEmailPatterns": [
    "^admin@vintora\\.local$",
    "^demo@vintora\\.local$"
  ],
  "note": "Phase 1 only. Seed identities and generated passwords are local/test development material and are never valid in staging or production."
}
